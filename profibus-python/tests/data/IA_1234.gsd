EndModule
Module = "Drive PPO1 (4 PKW + 2 PZD)" 0xF3, \
                                      0xF1
4
EndModule
Module = "Status (special format)" 0x42,0x07,0x01,0x02
5
EndModule
Module = "Empty slot" 0x00
6
EndModule
