; --- Diagnostics -------------------------------------------------------------
Unit_Diag_Bit(16)   = "Supply voltage missing"
Unit_Diag_Bit(17)   = "Module fault; see channel diagnosis"

; --- Parameters --------------------------------------------------------------
Max_User_Prm_Data_Len = 3
Ext_User_Prm_Data_Const(0) = 0x00,0x00,0x00

PrmText = 1
Text(0) = "disabled"
Text(1) = "enabled"
EndPrmText

ExtUserPrmData = 1 "Diagnosis"
Bit(0) 1 0-1
Prm_Text_Ref = 1
EndExtUserPrmData

Ext_User_Prm_Data_Ref(2) = 1

; --- Modules -----------------------------------------------------------------
Modular_Station     = 1
Max_Module          = 4
Max_Input_Len       = 32
Max_Output_Len      = 32
Max_Data_Len        = 64
Modul_Offset        = 1

Module = "8 DI  DC24V" 0x10
1
Info_Text = "8 digital inputs; 1 byte"
EndModule
Module = "8 DO  DC24V/0.5A" 0x20
2
EndModule
Module = "2 AI  4..20mA" 0x51
3
