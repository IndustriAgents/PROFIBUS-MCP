# Example settings for profibus-mcp. Copy to profibus-python/.env in a source
# checkout: that is the only .env the server reads by itself. It never reads a
# .env from its working directory or a parent directory, and an installed
# package reads none. Variables already set in the environment win.
#
# Only this server's own settings are applied from that file: PROFIBUS_* and
# SLAVE_MAP_FILE (names are compared upper-cased). Anything else (PATH,
# LD_PRELOAD, PYTHONPATH, ...) is ignored with a warning.

# Backend: mock (profibus-mock-slave over TCP) or serial (not implemented).
PROFIBUS_BACKEND=mock
PROFIBUS_MOCK_HOST=127.0.0.1
PROFIBUS_MOCK_PORT=7100

# Per-attempt timeout (ms), retries, first backoff delay (s). Each request is
# also bounded overall by timeout x (retries + 1) + backoff + 1 s.
PROFIBUS_TIMEOUT=1000
PROFIBUS_MAX_RETRIES=3
PROFIBUS_RETRY_BACKOFF_BASE=0.1

# serial backend only (not implemented; the port is never opened).
# PROFIBUS_PORT=/dev/ttyUSB0
# PROFIBUS_BAUDRATE=500000
# PROFIBUS_MASTER_ADDRESS=2

# Optional files.
# SLAVE_MAP_FILE=/absolute/path/to/slaves.json
# PROFIBUS_GSD_PATH=/absolute/path/to/gsd-files

# Safety switch. This file may NOT enable writes: the server ignores
# PROFIBUS_WRITES_ENABLED here (in any spelling) and logs a warning. Set it in
# the MCP client's "env" block (the process environment), or put it in a file
# you pass explicitly with --env-file:
#   uv run profibus-mcp --env-file /path/to/bench.env
# PROFIBUS_WRITES_ENABLED=true

# Optional isolated pyprofibus DP master (see docs/pyprofibus-backend.md).
# Bus enable authorizes startup/parameterization and configured cyclic initial outputs.
# PROFIBUS_BACKEND=pyprofibus
PROFIBUS_BUS_ENABLED=false
# PROFIBUS_PYPROFIBUS_PYTHON=/opt/pyprofibus-runtime/bin/python
# PROFIBUS_PYPROFIBUS_CONFIG=/absolute/path/master.conf
# PROFIBUS_PYPROFIBUS_OUTPUTS=/absolute/path/initial-outputs.json
# PROFIBUS_PYPROFIBUS_PHY=serial
