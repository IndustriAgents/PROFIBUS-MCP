# Example settings for profibus-mcp. Copy to .env in the directory the server
# runs in (profibus-python/ with `uv --directory ... run profibus-mcp`).
# Variables already set in the environment win over this file.

# Backend: mock (profibus-mock-slave over TCP) or serial (not implemented).
PROFIBUS_BACKEND=mock
PROFIBUS_MOCK_HOST=127.0.0.1
PROFIBUS_MOCK_PORT=7100

# Timeouts and retries (milliseconds / count / seconds).
PROFIBUS_TIMEOUT=1000
PROFIBUS_MAX_RETRIES=3
PROFIBUS_RETRY_BACKOFF_BASE=0.1

# serial backend only (not implemented; the port is never opened).
# PROFIBUS_PORT=/dev/ttyUSB0
# PROFIBUS_BAUDRATE=500000
# PROFIBUS_MASTER_ADDRESS=2

# Optional files.
# SLAVE_MAP_FILE=/absolute/path/to/slaves.json
# PROFIBUS_GSD_PATH=/absolute/path/to/gsd-files

# Safety switch. A .env found in the working directory may NOT enable writes:
# the server ignores PROFIBUS_WRITES_ENABLED here and logs a warning, because
# the working directory of a client-launched server can be an untrusted
# project. Set it in the MCP client's "env" block (the process environment),
# or put it in a file you pass explicitly with --env-file:
#   uv run profibus-mcp --env-file /path/to/bench.env
# PROFIBUS_WRITES_ENABLED=true
