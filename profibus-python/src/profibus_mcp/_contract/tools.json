{
  "schemaVersion": 1,
  "protocol": "profibus",
  "transport": "stdio",
  "tools": [
    {
      "name": "read_inputs",
      "description": "Select one target mode and provide only its parameters.\n\naddress: Read a slave's cyclic input bytes, returned as hex in raw_data_hex.\n\n        Read-only. Fails if the slave does not answer or has fewer input bytes than requested.\n        \n\nalias: read_inputs for the slave behind an alias from SLAVE_MAP_FILE. Read-only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slave_address": {
            "description": "DP station address of the slave (0-125)",
            "maximum": 125,
            "minimum": 0,
            "title": "Slave Address",
            "type": "integer"
          },
          "length": {
            "anyOf": [
              {
                "maximum": 244,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Number of input bytes to read (1-244). Omit to read all of the slave's input bytes.",
            "title": "Length"
          },
          "target": {
            "anyOf": [
              {
                "const": "address",
                "type": "string"
              },
              {
                "const": "alias",
                "type": "string"
              }
            ],
            "description": "Select the target mode described above."
          },
          "alias": {
            "description": "Alias defined in SLAVE_MAP_FILE",
            "minLength": 1,
            "title": "Alias",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "oneOf": [
          {
            "properties": {
              "slave_address": {
                "description": "DP station address of the slave (0-125)",
                "maximum": 125,
                "minimum": 0,
                "title": "Slave Address",
                "type": "integer"
              },
              "length": {
                "anyOf": [
                  {
                    "maximum": 244,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Number of input bytes to read (1-244). Omit to read all of the slave's input bytes.",
                "title": "Length"
              },
              "target": {
                "const": "address",
                "type": "string"
              }
            },
            "required": [
              "slave_address",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          },
          {
            "properties": {
              "alias": {
                "description": "Alias defined in SLAVE_MAP_FILE",
                "minLength": 1,
                "title": "Alias",
                "type": "string"
              },
              "length": {
                "anyOf": [
                  {
                    "maximum": 244,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Number of input bytes to read (1-244). Omit to read all of the slave's input bytes.",
                "title": "Length"
              },
              "target": {
                "const": "alias",
                "type": "string"
              }
            },
            "required": [
              "alias",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "write_outputs",
      "description": "Select one target mode and provide only its parameters.\n\naddress: Write output bytes to a slave. This changes physical outputs on the equipment.\n\n        Refused unless PROFIBUS_WRITES_ENABLED=true (default false); nothing is sent when refused.\n        \n\nalias: write_outputs for the slave behind an alias. This changes physical outputs on the equipment.\n\n        Refused unless PROFIBUS_WRITES_ENABLED=true (default false); nothing is sent when refused.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slave_address": {
            "description": "DP station address of the slave (0-125)",
            "maximum": 125,
            "minimum": 0,
            "title": "Slave Address",
            "type": "integer"
          },
          "data": {
            "description": "Output bytes to write, each 0-255, starting at the first output byte.",
            "items": {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 244,
            "minItems": 1,
            "title": "Data",
            "type": "array"
          },
          "target": {
            "anyOf": [
              {
                "const": "address",
                "type": "string"
              },
              {
                "const": "alias",
                "type": "string"
              }
            ],
            "description": "Select the target mode described above."
          },
          "alias": {
            "description": "Alias defined in SLAVE_MAP_FILE",
            "minLength": 1,
            "title": "Alias",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "oneOf": [
          {
            "properties": {
              "slave_address": {
                "description": "DP station address of the slave (0-125)",
                "maximum": 125,
                "minimum": 0,
                "title": "Slave Address",
                "type": "integer"
              },
              "data": {
                "description": "Output bytes to write, each 0-255, starting at the first output byte.",
                "items": {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 244,
                "minItems": 1,
                "title": "Data",
                "type": "array"
              },
              "target": {
                "const": "address",
                "type": "string"
              }
            },
            "required": [
              "slave_address",
              "data",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          },
          {
            "properties": {
              "alias": {
                "description": "Alias defined in SLAVE_MAP_FILE",
                "minLength": 1,
                "title": "Alias",
                "type": "string"
              },
              "data": {
                "description": "Output bytes to write, each 0-255, starting at the first output byte.",
                "items": {
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 244,
                "minItems": 1,
                "title": "Data",
                "type": "array"
              },
              "target": {
                "const": "alias",
                "type": "string"
              }
            },
            "required": [
              "alias",
              "data",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "scan_bus",
      "description": "List the DP slaves the backend reports: address, ident number, status and I/O lengths.\n\n        Read-only. With PROFIBUS_BACKEND=serial it returns success=false (not implemented).\n        ",
      "inputSchema": {
        "properties": {},
        "title": "scan_busArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
