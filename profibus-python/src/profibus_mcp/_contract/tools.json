    {
      "name": "load_gsd_file",
      "description": "Parse a PROFIBUS DP GSD file (ASCII keyword format): vendor, model, ident number, baud rates, modules.\n\n        Each module's I/O lengths are decoded from its configuration bytes. A bare file\n        name is also looked up in PROFIBUS_GSD_PATH. Does not touch the bus.\n        ",
      "inputSchema": {
        "properties": {
          "filepath": {
            "description": "Path or file name",
            "minLength": 1,
            "title": "Filepath",
            "type": "string"
          }
        },
        "required": [
          "filepath"
        ],
        "title": "load_gsd_fileArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_master_status",
      "description": "Report the master configuration: backend, port or mock endpoint, baud rate, address, timeouts, write gate.\n\n        Does not contact the bus.\n        ",
      "inputSchema": {
        "properties": {},
        "title": "get_master_statusArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ],
