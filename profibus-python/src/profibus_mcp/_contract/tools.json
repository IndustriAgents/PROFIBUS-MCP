        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "read_diagnosis",
      "description": "Read a slave's diagnosis (status and ident number) as the backend reports it. Read-only.",
      "inputSchema": {
        "properties": {
          "slave_address": {
            "description": "DP station address of the slave (0-125)",
            "maximum": 125,
            "minimum": 0,
            "title": "Slave Address",
            "type": "integer"
          }
        },
        "required": [
          "slave_address"
        ],
        "title": "read_diagnosisArguments",
        "type": "object",
